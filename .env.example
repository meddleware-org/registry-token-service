# registry-token-service — example environment configuration.
# Copy to `.env` and adjust. Do NOT commit a real .env or a real signing key.
#
# All values are read at startup by internal/config. Required values have no
# default and cause the process to exit non-zero if unset.

# HTTP listen port (optional; default 8080).
PORT=8080

# iss claim placed in issued JWTs. Must match the registry's configured issuer.
# Required.
TOKEN_ISSUER=https://token.example.com

# aud claim + registry service name the token targets. Must match the Docker
# client's `service` query parameter and the registry's `service` config.
# Required.
TOKEN_SERVICE=registry.example.com

# Issued-token lifetime in seconds (optional; default 300). Docker clients
# transparently re-fetch tokens on expiry — do not inflate this.
TOKEN_TTL=300

# Path to the PEM RSA private key used to sign tokens (optional; default shown).
# The key MUST be >= 4096-bit; the service refuses to start otherwise. The
# registry validates signatures with the matching public key (rootcertbundle).
RSA_PRIVATE_KEY_PATH=/etc/token-service/signing.key

# Ory Hydra public token endpoint — credentials are validated here, never locally.
# Required.
HYDRA_TOKEN_URL=http://hydra.auth.svc.cluster.local:4444/oauth2/token

# Ory Keto read API base URL — per-repository push/pull permissions are checked here.
# Required.
KETO_READ_URL=http://keto.auth.svc.cluster.local:4466

# Log verbosity: debug | info | warn | error (optional; default info).
LOG_LEVEL=info
